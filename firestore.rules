rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Issues collection: only authenticated users may create their own issues
    // and only the owner (customerId) can update them. Professionals and
    // authenticated users can read issues.
    match /issues/{issueId} {
      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.customerId == request.auth.uid;
      allow read: if request.auth != null;
      allow delete: if false;
    }

    // Users collection: only the user can read/write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: authenticated users can read most data; writing is restricted
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}