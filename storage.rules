rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Restrict issue image uploads so that only the owner (userId) can write
    // and authenticated users can read images for display within the app.
    match /issues/{userId}/{issueId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Deny other write attempts by default
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}